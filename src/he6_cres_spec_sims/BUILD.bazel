load("@aspect_rules_py//py:defs.bzl", "py_library", "py_test")
load("@pypi//:requirements.bzl", "requirement")
load("//tools:deps.bzl", "cdeps", "python_ide_backport")

py_library(
    name = "he6_cres_spec_sims",
    srcs = glob(
        ["**/*.py"],
        exclude = ["**/*_test.py"],
    ),
    data = [
        ":spec_tools/distributions/Data/He6.json",
        ":spec_tools/distributions/Data/Ne19.json",
        ":spec_tools/trap_field_profile_pkl/2021_trap_profile_mainfield_0T_trap_1A.csv",
    ],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = cdeps([
        requirement("argparse"),
        requirement("awkward-pandas"),
        requirement("natsort"),
        requirement("pandas"),
        requirement("psycopg2-binary"),
        requirement("pytz"),
        requirement("pyyaml"),
        requirement("scikit-learn"),
        requirement("uproot"),
    ]),
)

py_test(
    name = "config_test",
    srcs = [":simulation_blocks/config_test.py"],
    data = ["//:config_files/example.yaml"],
    main = ":simulation_blocks/config_test.py",
    deps = [
        ":he6_cres_spec_sims",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "eventBuilder_test",
    srcs = [":simulation_blocks/eventBuilder_test.py"],
    data = ["//:config_files/example.yaml"],
    main = ":simulation_blocks/eventBuilder_test.py",
    deps = [
        ":he6_cres_spec_sims",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "DAQ_test",
    srcs = [":simulation_blocks/DAQ_test.py"],
    main = ":simulation_blocks/DAQ_test.py",
    deps = [":he6_cres_spec_sims"],
)

python_ide_backport()
